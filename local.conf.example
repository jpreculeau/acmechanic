# shellcheck shell=bash
# local.conf.example - Modèle de réglages machine pour Acmechanic.
# Copiez-le en local.conf (ignoré par git) puis adaptez-le :
#   cp local.conf.example local.conf

# --- Où chercher les services en plus de services/ ---
# SERVICES_EXTRA_DIRS=("$HOME/scripts")

# --- Délais ---
# DELAI_SERVICE=3000
# DELAI_SYSTEME=1800
# DELAI_VERROU_PARTAGE=120     # pull/up derrière un prune en cours
# DELAI_VERROU_EXCLUSIF=1200   # prune de nettoyage derrière les pulls

# --- Verrous ---
# Dossier à créer vous-même (mkdir -p) : absent, l'orchestrateur et ses
# services s'arrêtent aussitôt avec une erreur. Persistant de préférence,
# si /tmp est purgé par un outil qui ignore les verrous (un systemd-tmpfiles
# récent les respecte).
# Même valeur pour TOUS les scripts : `export` la transmet aux services
# lancés par l'orchestrateur, y compris ceux qui ne lisent pas local.conf.
# Et pour un prune à la main :
#   flock -x <VERROU_DIR>/maintenance-docker-prune.lock docker image prune -f
# export VERROU_DIR="$HOME/.local/state/acmechanic"   # défaut : /tmp

# --- Sauvegardes ---
# BACKUP_ROOT="/chemin/vers/disque/backups"
# BACKUP_GARDER=5

# --- Ressources (lib/common.sh) ---
# LIMITE_CPU=200%            # quota CPU de chaque service (200% = 2 cœurs)
# LIMITE_RAM_SOUPLE=1G
# LIMITE_RAM_DURE=2G
# LIMITES_RESSOURCES=non     # désactive cgroups + nice/ionice

# --- Services de la bibliothèque (voir bibliotheque/README.md) ---
# Convention : <NOM>_PROJET, <NOM>_DONNEES, <NOM>_URL, <NOM>_CANAL
# JELLYFIN_PROJET="/opt/media/jellyfin"
# JELLYFIN_CANAL=unstable
# ARR_SERVICES=(sonarr radarr)
# SONARR_CANAL=develop

# --- Affichage ---
# ACMECHANIC_LANGUE=fr               # fr, en... (défaut : langue du système)
# ACMECHANIC_LIGNES_MIN=6           # lignes minimum par cadre (ascenseur au-delà de l'écran)
# ACMECHANIC_THEME=godzilla             # acme (défaut), starwars, godzilla, matrix, terminator, delorean, enterprise, hasard
# declare -A ICONES_SERVICES=([mon-app]=$'\xef\x80\x95')   # icône Nerd Font d'un cadre

# --- Maintenance de la machine ---
# DEPOTS_GIT=("$HOME/acmefrag" "$HOME/outils/mon-script")
# IA_OUTILS="claude npm uv pipx pi hermes ollama"
# IA_NPM=(@openai/codex @google/gemini-cli)
# CLAUDE_REPRISE_ATTENTE=30        # s avant le second essai de « claude update » en échec
# OLLAMA_MAJ=oui                    # installer les nouvelles versions d'Ollama (sinon : signalées)
# SESSION_GRAPHIQUE_PIP_GIT=(nwg-panel)  # barre installée depuis git, avec correctifs :
# NWG_PANEL_SRC="$HOME/src/nwg-panel"
# NWG_PANEL_CORRECTIFS=(ma-branche-de-correctif)
# NETTOYAGE_JOURNAL=2weeks          # ou non
# CROSS_SEED_CONFIG="$HOME/cross-seed/config/config.js"   # config.js lu sur l'hôte (linkDirs, dataDirs)
# CROSS_SEED_QBIT_URL="http://utilisateur:motdepasse@127.0.0.1:8080"   # défaut : torrentClients de config.js
# CROSS_SEED_LIENS=non              # pas de contrôle des liens physiques au démarrage de cross-seed
# ACMEFRAG_CIBLE="/chemin/vers/disque/Videos"
# ACMEFRAG_SANTE_CIBLE="/chemin/vers/disque"  # santé SMART (défaut : ACMEFRAG_CIBLE ; "" = rien)
# ACMEFRAG_DELAI_SANTE=120          # s
# ACMECHANIC_AUTO_MAJ=signaler      # oui (défaut) | signaler | non

# --- Applications Flatpak sauvegardées (bibliotheque/flatpak) ---
# FLATPAK_SAUVEGARDES=(
# 	"monapp:org.exemple.MonApp"
# )

